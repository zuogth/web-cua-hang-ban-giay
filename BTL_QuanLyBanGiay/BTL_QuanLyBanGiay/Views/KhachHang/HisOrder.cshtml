@model IEnumerable<BTL_QuanLyBanGiay.Models.HoaDonBan>

@{
    ViewBag.Title = Session["KhachHang"];
    Layout = "~/Views/_Layout.cshtml";
}
<link href="~/Assest/layout/css/useroptions.css" rel="stylesheet" />
<div class="khachhang row">
    <h2>Lịch sử mua hàng</h2>
    <div class="noidung col-sm-8">
        <hr />
        @foreach (var item in Model)
        {
            <div class="hisorder">
                <div class="d-flex">
                    <div>
                        <h4>Ngày đặt: @string.Format("{0:dd/MM/yyy}", item.NgayBan)</h4>
                    </div>
                    <div>
                        <h4>Tổng tiền: <span>@string.Format("{0:0,00}", item.TongTien) đ</span></h4>
                    </div>
                    <div>
                        <span><i class="fa fa-chevron-down" data-toggle="collapse" data-target="#@item.SoHDB"></i></span>
                    </div>
                </div>
                <div id="@item.SoHDB" class="collapse chitietorder">
                    @Html.Action("HisProdOrder", "KhachHang", new { SoHDB = item.SoHDB })
                </div>
            </div>
        }
        <div>
            <a href="@Url.Action("Shop","Home")" class="buttonadd">Tiếp tục mua hàng</a>
        </div>
    </div>
    <div class="options col-sm-4">
        <ul>
            <li><a href="@Url.Action("Edit","KhachHang",new {MaKhach=Session["MaKhach"] })">Thông tin cá nhân</a></li>
            <li><a href="@Url.Action("HisOrder","KhachHang",new { MaKhach=Session["MaKhach"]})">Lịch sử mua hàng</a></li>
        </ul>
    </div>
</div>
<div id="formdanhgiamodal" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btnclose">&times;</button>
                <h4 class="modal-title">Đánh giá sản phẩm!</h4>
            </div>
            <div class="formDanhgia-prod">
                <form id="formDanhgia">
                    <div>
                        <input class="input-tensp" name="TenSP" id="TenSP" readonly />
                    </div>
                    <div>
                        <input class="input-noidung" type="text" name="NoiDung" id="NoiDung" placeholder="Nội dung..." required/>
                    </div>
                    <div>
                        <label for="DanhGiaStar">Đánh giá: </label>
                        <select name="DanhGiaStar" id="DanhGiaStar">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>  
                        <span class="fa fa-star checked"></span>
                    </div>
                    <div>
                        <input class="btn-danhgia" id="btnsubmit" type="button" value="Submit" onclick="adddanhgia(this)" />
                    </div>
                </form>                
            </div>
            @*<div class="modal-footer">
                    <a href="@Url.Action("Index", "Cart")" id="buttonadd">Checkout</a>
                </div>*@
        </div>
    </div>
</div>
<div id="formreview-danhgiamodal" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btnclose_ed">&times;</button>
                <h4 class="modal-title">Đã đánh giá sản phẩm!</h4>
            </div>
            <div class="formDanhgia-prod">
                
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var nameid;
    function gettensp(item) {
        var name = $(item).attr("data-tensp");
        $('input#TenSP').val(name);
        nameid = $(item).attr("id");
        $('#formdanhgiamodal').show();
    }
    function adddanhgia(item) {

        //Serialize the form datas.
        var valdata = $("#formDanhgia").serialize();
        //to get alert popup
        $.ajax({
            url: "/KhachHang/AddDanhGia",
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data:valdata,
            success: function (data) {
                $('#formdanhgiamodal').hide();
                $('input#TenSP').val('');
                $('input#NoiDung').val('');
                $('input#DanhGiaStar').val('');
                $('.options-order #' + nameid).text('Xem đánh giá');
                $('txtDanhgia #' + nameid).text('Đã đánh giá');
                alert("Đánh giá thành công");
            },
            error: function () {
                alert("Đánh giá thất bại");
            }
        });
    };
    function getmadg(item) {
        var madg = $(item).attr("data-madg")
        var formdata = new FormData();
        formdata.append("MaDG", madg);
        $('#formreview-danhgiamodal').show();
        $('.formDanhgia-prod').html("");
        $.ajax({
            async: false,
            url: "/KhachHang/DanhGia",
            type: "POST",
            processData: false,
            contentType: false,
            data: formdata,
            success: function (data) {
                let html = `<h4>${data.TenSP}</h4>
                <hr />
                <h5>${data.TenKhach}</h5>
                <i>${data.NgayDG}</i>
                <p>`;
                for (let i = 0; i < data.Star; i++)
                {
                    html += `<span class="fa fa-star checked"></span>`;
                }
                html += `</p>
                        <p>Nội dung: <span>${data.NoiDung}</span></p>`;
                $('.formDanhgia-prod').append(html);
            },
            error: function () {
                alert("Đánh giá thất bại");
            }
        });
    }
</script>

