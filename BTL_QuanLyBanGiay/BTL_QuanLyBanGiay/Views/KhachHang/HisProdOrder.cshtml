@model IEnumerable<BTL_QuanLyBanGiay.Models.ChiTietHDB>
@using System.Text;

@foreach (var item in Model)
{
    string s = item.SanPham.TenSP;
    byte[] bytes = Encoding.ASCII.GetBytes(s);
    long result = BitConverter.ToInt32(bytes, 0);
    <div class="row list-prod-order">
        <div class="col-sm-2 img">
            <img src="@Url.Content("~/images/"+item.SanPham.Anh)" />
        </div>
        <div class="col-sm-10">
            <div>
                <h5>@item.SanPham.TenSP</h5>
                <h5>Màu: @item.SanPham.Mau.TenMau, Size: @item.SanPham.Co.TenCo</h5>
                <h5>Đơn giá: @string.Format("{0:0,00}", item.SanPham.DonGiaBan) đ</h5>
                <h5>x: @item.SoLuong</h5>
            </div>
            @if (item.MaDG == null)
            {
                <div class="options-order">
                    <a href="@Url.Action("XemChiTiet","Home",new { MaSP=item.SanPham.MaSP})" class="btnagain">Mua lần nữa</a>
                    <a href="#" class="btnagain" id="@(result+"a")" onclick="gettensp(this)" data-tensp="@item.SanPham.TenSP" data-toggle="modal" data-target="#formdanhgiamodal">Đánh giá</a>
                </div>
                <h5 class="txtDanhgia" ><span id="@(result+"span")">Chưa đánh giá</span></h5>
            }
            else
            {
                <div class="options-order">
                    <a href="@Url.Action("XemChiTiet","Home",new { MaSP=item.SanPham.MaSP})" class="btnagain">Mua lần nữa</a>
                    <a href="#" class="btnagain" onclick="gettensp(this)" data-tensp="@item.SanPham.TenSP" data-toggle="modal" data-target="#formreview-danhgiamodal">Xem đánh giá</a>
                </div>
                <h5 class="txtDanhgia">Đã đánh giá</h5>
            }
        </div>
    </div>

}



