@model BTL_QuanLyBanGiay.Models.KhachHang
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/_Layout.cshtml";
}
<link href="~/Assest/layout/css/loginuser.css" rel="stylesheet" />
<div class="bg-login-regis">
    <div class="login">
        @if (ViewBag.Err != null)
        {
            <h5>@ViewBag.Err</h5>
        }
        @using (Html.BeginForm("Login", "KhachHang"))
        {
            <div>
                @Html.TextBoxFor(x => x.DienThoai, new { @class = "input", @placeholder = "Số điện thoại" })
            </div>
            <div>
                @Html.PasswordFor(x => x.Password, new { @class = "input", @placeholder = "Mật khẩu" })
            </div>
            <div>
                <button type="submit" class="btn btn-default">Login</button>
            </div>
            <a href="@Url.Action("Signup","KhachHang")">Sign up?</a>
        }
    </div>
</div>


