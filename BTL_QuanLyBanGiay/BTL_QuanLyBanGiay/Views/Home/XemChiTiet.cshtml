<script type="text/javascript">
    function AddtoCart(item) {
        var MaSP = $(item).attr("masp");
        var formData = new FormData();
        formData.append("MaSP", MaSP);
        $.ajax({
            async: true,
            type: 'POST',
            contentType: false,
            processData: false,
            data: formData,
            url: '/Cart/Index',
            success: function (data) {
                $('#countCart').text(data.Counter);
                $('#slProd').text(data.Counter + " sản phẩm");
                $('#money').text("Tổng tiền: " + data.Money + " đ");
            },
            error: function () {
                alert("There is some problem");
            }
        });
    };
    
</script>

