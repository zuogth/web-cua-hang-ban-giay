@model BTL_QuanLyBanGiay.Models.SanPham
@using BTL_QuanLyBanGiay.Models;
@using PagedList.Mvc;
@{
    ViewBag.shop = "Shop";
    ViewBag.Title = Html.DisplayFor(model => model.TenSP);
    Layout = Layout = "~/Views/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Assest/layout/css/flexslider.css" type="text/css" media="screen" />
<div class="occasion-cart">
    <div class="shoe single-item single_page_b">
        <button type="button" id="buttonback">
            <a href="@Url.Action("Shop", "Home")">Back</a>
        </button>

    </div>

</div>
<div class="ads-grid_shop">
    <div class="shop_inner_inf">
        <div class="col-md-4 single-right-left ">
            <div class="grid images_3_of_2">
                <div class="flexslider">

                    <ul class="slides">
                        @{Html.RenderAction("AnhSP", "Home", new { TenSP = Html.DisplayFor(model => model.TenSP),MaMau= Html.DisplayFor(model => model.MaMau) }); }
                    </ul>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
        <div class="col-md-8 single-right-left simpleCart_shelfItem">
            <h3 masp="@Model.MaSP" id="tenSP">@Html.DisplayFor(model => model.TenSP)</h3>
            <p>
                <span class="item_price">@string.Format("{0:0,00}", (Double.Parse(Html.DisplayFor(model => model.DonGiaBan).ToString()))) đ</span>
                <del>@((Double.Parse(Html.DisplayFor(model => model.DonGiaBan).ToString()) * 1.5).ToString())</del>
            </p>
            <div class="description">
                <h5>Check delivery, payment options and charges at your location</h5>
                <form action="#" method="post">
                    <input type="text" value="Enter pincode" onfocus="this.value = '';" onblur="if (this.value == '') {this.value = 'Enter pincode';}"
                           required="">
                    <input type="submit" value="Check">
                </form>
            </div>
            <div class="color-quality">
                <div class="color-quality-right">
                    <h5>Size :</h5>
                    @Html.Action("Size", "Home", new {TenSP=Model.TenSP,MaMau=Model.MaMau})
                </div>
            </div>
            <div class="occasional">
                <h5>Types :</h5>
                <div class="colr ert">
                    <label class="radio"><input type="radio" name="radio" checked=""><i></i>Casual Shoes</label>
                </div>
                <div class="colr">
                    <label class="radio"><input type="radio" name="radio"><i></i>Sneakers </label>
                </div>
                <div class="colr">
                    <label class="radio"><input type="radio" name="radio"><i></i>Formal Shoes</label>
                </div>
                <div class="clearfix"> </div>
            </div>
            <div class="occasion-cart">
                <div class="shoe single-item single_page_b">
                    <form action="#" method="post">
                        <button type="button" class="buttonadd" masp="@Model.MaSP" onclick="AddtoCart(this)" data-toggle="modal" data-target="#myModal">Add to cart</button>
                        @*<a href="@Url.Action("Buy","Cart",new { MaSP=Model.MaSP})" class="buttonadd">Add to cart</a>*@
                    </form>

                </div>
            </div>
            <div class="modal fade" id="myModal" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-title">Đã thêm vào giỏ hàng!</h4>
                        </div>
                        <div class="modal-body-prod">
                            <div class="singleProduct">
                                @{ Html.RenderAction("Cart", "Cart", new { MaSP = Model.MaSP });}
                            </div>
                            <div class="cartProduct">
                                <h4>Giỏ hàng của bạn</h4>
                                <h6 id="slProd">sả phẩm</h6>
                                <h6 id="money">Tổng tiền: </h6>
                                <a href="@Url.Action("Index","Cart")" class="buttonadd buttonadd-single">Checkout</a>
                            </div>
                        </div>
                        @*<div class="modal-footer">
                            <a href="@Url.Action("Index", "Cart")" id="buttonadd">Checkout</a>
                        </div>*@
                    </div>
                </div>
            </div>
            <ul class="social-nav model-3d-0 footer-social social single_page">
