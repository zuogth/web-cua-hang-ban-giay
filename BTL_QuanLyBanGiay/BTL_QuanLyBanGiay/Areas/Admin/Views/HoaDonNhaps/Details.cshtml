@model BTL_QuanLyBanGiay.Models.HoaDonNhap

@{
    ViewBag.active = 4;
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    Session["SoHDN"] = Model.SoHDN;
}

<div>
    <h4>Hóa đơn nhập</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Ngày nhập
        </dt>

        <dd>
            @string.Format("{0:dd/MM/yyyy}",Model.NgayNhap)
        </dd>

        <dt>
           Tổng tiền
        </dt>

        <dd>
            @string.Format("{0:0,00}",Model.TongTien) đ
        </dd>

        <dt>
            Tên NCC
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NhaCungCap.TenNCC)
        </dd>

        <dt>
            Tên NV
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NhanVien.TenNV)
        </dd>

    </dl>
    @{ Html.RenderAction("Index", "ChiTietHDNs");}
</div>
<p>
    <a href="@Url.Action("Index","HoaDonNhaps")" class="btn btn-default"><i class="fa fa-arrow-left"></i>Back</a>
</p>
