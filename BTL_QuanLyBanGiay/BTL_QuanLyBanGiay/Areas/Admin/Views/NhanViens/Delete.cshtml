@model BTL_QuanLyBanGiay.Models.NhanVien

@{
    ViewBag.active = 1;
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h4>Are you sure you want to delete this?</h4>
<div>
    <dl class="dl-horizontal">
        <dt>
            Mã
        </dt>

        <dd>
            @Html.DisplayFor(model => model.MaNV)
        </dd>
        <dt>
            Họ và tên
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TenNV)
        </dd>

        <dt>
            Giới tính
        </dt>

        <dd>
            @Html.DisplayFor(model => model.GioiTinh)
        </dd>

        <dt>
            Ngày sinh
        </dt>

        <dd>
            @string.Format("{0:dd/mm/yyyy}",Model.NgaySinh)
            @*@Html.DisplayFor(model => model.NgaySinh)*@
        </dd>

        <dt>
            Số điện thoại
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DienThoai)
        </dd>

        <dt>
            Địa chỉ
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DiaChi)
        </dd>

        <dt>
            Công việc
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CongViec.TenCV)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

<div class="form-actions no-color">
    <a href="@Url.Action("Index","NhanViens")" class="btn btn-default"><i class="fa fa-arrow-left"></i>Back</a>
    <input type="submit" value="Delete" class="btn btn-warning" />
</div>
    }
</div>
