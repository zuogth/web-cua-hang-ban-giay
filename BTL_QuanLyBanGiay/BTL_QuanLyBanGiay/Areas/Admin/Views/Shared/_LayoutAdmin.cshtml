<!DOCTYPE html>
<!--
Template Name: BRILLIANT Bootstrap Admin Template
Version: 4.5.6
Author: WebThemez
Website: http://www.webthemez.com/
-->
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="" name="description" />
    <meta content="webthemez" name="author" />
    <title>@ViewBag.Title</title>
    <!-- Bootstrap Styles-->
    <link href="~/Assest/admin/css/bootstrap.css" rel="stylesheet" />
    <!-- FontAwesome Styles-->
    <link href="~/Assest/admin/css/font-awesome.css" rel="stylesheet" />
    <!-- Morris Chart Styles-->
    <link href="~/Assest/admin/js/morris/morris-0.4.3.min.css" rel="stylesheet" />
    <!-- Custom Styles-->
    <link href="~/Assest/admin/css/custom-styles.css" rel="stylesheet" />
    <!-- Google Fonts-->
    <link href='http://fonts.googleapis.com/css?family=Open+Sans' rel='stylesheet' type='text/css' />
    @*<link href="~/Assest/admin/js/Lightweight-Chart/cssCharts.css" rel="stylesheet" />*@
</head>

<body>
    <div id="wrapper">
        <nav class="navbar navbar-default top-navbar" role="navigation">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".sidebar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="@Url.Action("Products","Products")"><strong> DownyShoes</strong></a>
            </div>

            <ul class="nav navbar-top-links navbar-right">
                
                <!-- /.dropdown -->
                
                <!-- /.dropdown -->
                
                <!-- /.dropdown -->
                <li class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#" aria-expanded="false">
                        <i class="fa fa-user fa-fw"></i> <i class="fa fa-caret-down"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        @if (Session["UserName"] != null)
                        {

                            <li>
                                <a href="#"><i class="fa fa-user fa-fw"></i> @Session["UserName"]</a>
                            </li>
                            <li>
                                <a href="#"><i class="fa fa-gear fa-fw"></i> Settings</a>
                            </li>
                            <li class="divider"></li>
                            <li>
                                <a href="@Url.Action("Logout","User")"><i class="fa fa-sign-out fa-fw"></i> Logout</a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="@Url.Action("Login","User")"><i class="fa fa-sign-out fa-fw"></i> Login</a>
                            </li>
                        }
                    </ul>
                        <!-- /.dropdown-user -->
                    </li>
                <!-- /.dropdown -->
            </ul>
        </nav>
        <!--/. NAV TOP  -->
        <nav class="navbar-default navbar-side" role="navigation">
            <div class="sidebar-collapse">
                <ul class="nav" id="main-menu">

                    <li>
                        <a href="@Url.Action("Products","Products")"><i class="fa fa-dashboard"></i> Products</a>
                    </li>
                    <li>
                        <a href="#"><i class="fa fa-users"></i> People<span class="fa arrow"></span></a>
                        <ul class="nav nav-second-level">
                            <li>
                                <a href="@Url.Action("Index","KhachHangs")">Customer</a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index","NhanViens")">Staff</a>
                            </li>
                        </ul>
                    </li>

                    <li>
                        <a href="#"><i class="fa fa-tasks"></i> Record<span class="fa arrow"></span></a>
                        <ul class="nav nav-second-level">
                            <li>
                                <a href="@Url.Action("Index","HoaDonNhaps")">Import</a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index","HoaDonBans")">Sell</a>
                            </li>
                        </ul>
                    </li>

                    <li>
                        <a href="@Url.Action("Contacts","Contacts")"><i class="fa fa-table"></i> Contacts</a>
                    </li>
                    
                </ul>

            </div>

        </nav>
        <!-- /. NAV SIDE  -->
        <div id="page-wrapper">
            <div class="header">
                <h1 class="page-header">
                    @ViewBag.Title
                </h1>
            </div>
            <div id="page-inner">
                @RenderBody()
            </div>
            <!-- /. PAGE INNER  -->
        </div>

    </div>
    <!-- /. WRAPPER  -->
    <!-- JS Scripts-->
    <!-- jQuery Js -->
    <script src="~/Assest/admin/js/jquery-1.10.2.js"></script>
    <!-- Bootstrap Js -->
    <script src="~/Assest/admin/js/bootstrap.min.js"></script>

    <!-- Metis Menu Js -->
    <script src="~/Assest/admin/js/jquery.metisMenu.js"></script>

    <!-- Custom Js -->
    <script src="~/Assest/admin/js/custom-scripts.js"></script>

    <script>
        $(document).after(function () {
            document.querySelectorAll("#main-menu li")[@ViewBag.active].querySelector("a").style.background = "#EDEDED";
            document.querySelectorAll("#main-menu li")[@ViewBag.active].querySelector("a").style.color = "#F36A5A";
            document.querySelectorAll("#main-menu li")[@ViewBag.active].querySelector("i").style.color = "#F36A5A";

        });
    </script>

</body>

</html>